<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)..\..\eng\survival-beta.NuGet.Config</RestoreConfigFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetLockFilePath Condition="'$(DeepProtocolLocalCutover)' == 'true'">$(MSBuildThisFileDirectory)..\..\artifacts\local-protocol-cutover\locks\$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DeepProtocolSourceCutover)' == 'true'">
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
    <NuGetLockFilePath>$(BaseIntermediateOutputPath)source-cutover\packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XNode.Core\XNode.Core.csproj" />
    <ProjectReference Include="..\..\src\XNode.Transport.Vless\XNode.Transport.Vless.csproj" />
    <ProjectReference Include="..\..\src\XNode.Registry\XNode.Registry.csproj" />
    <ProjectReference Include="..\..\src\XNode\XNode.csproj" />
  </ItemGroup>

  <!-- Explicit local business slice only; the default release gate still compiles every test. -->
  <ItemGroup Condition="'$(ContactCoordinationFocused)' == 'true'">
    <Compile Remove="**\*.cs" />
    <Compile Include="Runtime\ContactCoordinationBackendClientTests.cs" />
    <Compile Include="Runtime\ContactCoordinationOnionDispatcherTests.cs" />
    <Compile Include="Runtime\Did2ContactServiceCompositionTests.cs" />
    <Compile Include="Runtime\DeepIdV2PublicationAuthorityFixture.cs" />
    <Compile Include="Runtime\DeepIdV2NetworkPlacementOptionsTests.cs" />
    <Compile Include="Runtime\DeepIdV2NetworkPlacementRuntimeTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublicationConsumerFocused)' == 'true'">
    <Compile Remove="**\*.cs" />
    <Compile Include="Runtime\DeepIdV2PublicationAuthorityFixture.cs" />
    <Compile Include="Runtime\DeepIdV2OpaquePublicationConsumerTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PrivacyRecoveryFocused)' == 'true'">
    <Compile Remove="**\*.cs" />
    <Compile Include="Runtime\PrivacyRoutingRuntimeTests.cs" />
    <Compile Include="Runtime\DeepIdV2PublicationAuthorityFixture.cs" />
  </ItemGroup>
</Project>
