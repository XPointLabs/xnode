ARG SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.301@sha256:ea8bde36c11b6e7eec2656d0e59101d4462f6bd630730f2c8201ed0572b295d5
FROM ${SDK_IMAGE} AS blob-storage-tests
WORKDIR /src/xnode
COPY Directory.Build.props ./
COPY eng/survival-beta.NuGet.Config ./eng/
COPY src ./src
COPY tests/XNode.Tests ./tests/XNode.Tests
COPY --from=deep_protocol . /src/deep-protocol
RUN dotnet test tests/XNode.Tests/XNode.Tests.csproj --configuration Release \
    -m:1 -p:UseSharedCompilation=false -p:DeepProtocolSourceCutover=true \
    --filter FullyQualifiedName~DurableBlobChunkStoreTests \
    --logger trx --results-directory /test-results
