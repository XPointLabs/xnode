<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>win-arm64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)..\..\vendor\p04\packages</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Deep.Protocol" Version="[0.3.0-p04.b887fa0]" />
    <PackageReference Include="Deep.Protocol.ProfileCarrier" Version="[0.1.0-p14.faa598f]" />
  </ItemGroup>

</Project>
