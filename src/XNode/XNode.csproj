<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\XNode.Core\XNode.Core.csproj" />
    <ProjectReference Include="..\XNode.Transport.Vless\XNode.Transport.Vless.csproj" />
    <ProjectReference Include="..\XNode.Registry\XNode.Registry.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)..\..\eng\survival-beta.NuGet.Config</RestoreConfigFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetLockFilePath Condition="'$(DeepProtocolLocalCutover)' == 'true'">$(MSBuildThisFileDirectory)..\..\artifacts\local-protocol-cutover\locks\$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XNode.IntegrationTests" />
  </ItemGroup>

</Project>
