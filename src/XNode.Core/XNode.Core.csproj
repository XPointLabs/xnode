<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)..\..\eng\survival-beta.NuGet.Config</RestoreConfigFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetLockFilePath Condition="'$(DeepProtocolLocalCutover)' == 'true'">$(MSBuildThisFileDirectory)..\..\artifacts\local-protocol-cutover\locks\$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DeepProtocolSourceCutover)' == 'true'">
    <!-- Foreign Protocol projects are absent from XNode.slnx. Preserve this
         project's actual Configuration without customizing discovery anchors. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
    <NuGetLockFilePath>$(BaseIntermediateOutputPath)source-cutover\packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup Condition="'$(DeepProtocolLocalCutover)' != 'true' and '$(DeepProtocolSourceCutover)' != 'true'">
    <PackageReference Include="Deep.Protocol" Version="[0.5.0-production.e75bfed]" />
    <PackageReference Include="Deep.Protocol.MembershipRoutes" Version="[0.5.0-production.e75bfed]" />
  </ItemGroup>

  <ItemGroup Condition="'$(DeepProtocolLocalCutover)' == 'true' and '$(DeepProtocolSourceCutover)' != 'true'">
    <PackageReference Include="Deep.Protocol" Version="[$(DeepProtocolLocalPackageVersion)]" />
    <PackageReference Include="Deep.Protocol.MembershipRoutes" Version="[$(DeepProtocolLocalPackageVersion)]" />
  </ItemGroup>

  <ItemGroup Condition="'$(DeepProtocolSourceCutover)' == 'true'">
    <!-- Solution traversal needs the override for foreign children. Ordinary
         project publish already preserves Configuration; adding a global
         property there creates distinct instances sharing the same outputs. -->
    <ProjectReference Include="..\..\..\deep-protocol\src\Deep.Protocol\Deep.Protocol.csproj">
      <AdditionalProperties Condition="'$(BuildingSolutionFile)' == 'true'">ShouldUnsetParentConfigurationAndPlatform=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\..\deep-protocol\src\Deep.Protocol.MembershipRoutes\Deep.Protocol.MembershipRoutes.csproj">
      <AdditionalProperties Condition="'$(BuildingSolutionFile)' == 'true'">ShouldUnsetParentConfigurationAndPlatform=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Rebex.Elliptic.Ed25519" Version="1.2.2" />
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XNode" />
    <InternalsVisibleTo Include="XNode.Tests" />
    <InternalsVisibleTo Include="XNode.IntegrationTests" />
  </ItemGroup>

</Project>
